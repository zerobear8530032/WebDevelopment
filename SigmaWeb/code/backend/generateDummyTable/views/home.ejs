<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/css/style.css">
  <title>Employee List</title>
</head>
<body>
  <header>
    <h1>Employee List</h1>
  </header>

  <% if(data){%>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Salary</th>
        <th>Language</th>
        <th>City</th>
        <th>Is Manager?</th>
      </tr>
    </thead>
    <% for (const employee of data){ %>
    <tbody>
      <tr>
        <td><%= employee.name %></td>
        <td><%= employee.salary %></td>
        <td><%= employee.language %></td>
        <td><%= employee.city %></td>
        <td class="yes"><%- employee.isManager? "Yes": "No" %></td>
      </tr>
    </tbody>
    <% } %>
  </table>
  <%}%>
<form method="POST">
  <button type="submit" formaction="/generate">Generate</button>
  <button type="submit" formaction="/delete">delete</button>

</form>
</body>
</html>
