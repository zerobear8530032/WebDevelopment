<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Journal</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="css/form.css">
</head>
<body>
    <%- include("header.ejs") %>
    <div class="page-heading flex">
        <h2 class="font"> Add Journal </h2>
    </div>
    <section class="form-container flex font">
        <form action="/addjournal" method="POST" class="form flex">
            <div class="form-field flex font">
                <label for="title">Title</label>
                <input type="text" name="title" id="title" placeholder="Journal Title" required>
            </div>
            <div class="form-field flex font">
                <label for="author">Author Name</label>
                <input type="text" name="author" id="author" placeholder="Author Name" required>
            </div>
            <div class="form-field flex font">
                <label for="description">Description</label>
                <textarea name="description" id="description" placeholder="Description" required></textarea>
            </div>
            <div class="form-field flex button">
                <button type="submit">Submit</button>
            </div>
        </form>
    </section>
</body>
</html>